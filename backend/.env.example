DATABASE_URL="postgresql://dejavu:dejavu@localhost:5432/dejavu?schema=public"
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Max login/register attempts per IP per minute
AUTH_RATE_LIMIT=10

STORE_TIMEZONE="Africa/Cairo"

# Set to the number of proxy hops (e.g. 1) when running behind nginx / a load balancer
# TRUST_PROXY=1

# Interactive API docs at /docs (set to false to disable in production)
SWAGGER_ENABLED=true

# Address the outside world uses to reach this server (no /api/v1). Paymob needs https.
# Defaults to http://localhost:3000 (or the forwarded URL inside GitHub Codespaces).
# PUBLIC_BASE_URL="https://api.your-store.com"

# Card payments: test = built-in fake card page (development), paymob = real payments, none = off.
# Defaults to "test" in development and "none" when NODE_ENV=production.
PAYMENT_GATEWAY="test"
# From the Paymob dashboard (Settings / Developers). Callback URL to register:
#   ${PUBLIC_BASE_URL}/api/v1/payments/paymob/callback
# PAYMOB_SECRET_KEY="egy_sk_test_..."
# PAYMOB_PUBLIC_KEY="egy_pk_test_..."
# PAYMOB_INTEGRATION_ID="1234567"
# PAYMOB_HMAC_SECRET="..."
# PAYMOB_API_URL="https://ksa.paymob.com"   # KSA account (SAR); https://accept.paymob.com for Egypt
# PAYMOB_CURRENCY="SAR"

# Unpaid card orders are cancelled after this many minutes (stock goes back on sale). 0 = never.
CARD_PAYMENT_TIMEOUT_MINUTES=60

# Push notifications: a Firebase service-account key (Project settings → Service accounts →
# Generate new private key), as raw JSON or base64. Without it, notifications still appear
# inside the apps; only the phone push is skipped.
# FCM_SERVICE_ACCOUNT=""

# Shopping assistant (Gemini) in the customer app — key from aistudio.google.com; empty = off
# GEMINI_API_KEY=""
