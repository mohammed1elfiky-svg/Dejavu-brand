# Copy to .env.prod and fill in. Never commit the real file.

# Your API domain; its DNS A record must point at this server.
DOMAIN=api.your-store.com

# Generate both with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=

# First admin account (created on the first start only).
SEED_ADMIN_EMAIL=owner@your-store.com
SEED_ADMIN_PASSWORD=

DEMO_DATA=false
SWAGGER_ENABLED=false
STORE_TIMEZONE=Africa/Cairo

# Card payments: none, or paymob with the keys from the Paymob dashboard.
# Register this callback in Paymob: https://<DOMAIN>/api/v1/payments/paymob/callback
PAYMENT_GATEWAY=none
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
CARD_PAYMENT_TIMEOUT_MINUTES=60

# Push notifications: Firebase service-account key as base64 (base64 -w0 key.json).
FCM_SERVICE_ACCOUNT=
